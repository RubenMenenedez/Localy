generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  HAIR_SALON
  BARBERSHOP
  BEAUTY_CENTER
  NAIL_SALON
  SPA
  TATTOO_STUDIO
  CLINIC
  DENTIST
  PHYSIOTHERAPY
  PSYCHOLOGIST
  VETERINARY
  PET_GROOMING
  AUTO_REPAIR
  CAR_WASH
  RESTAURANT
  CAFE
  BAKERY
  GYM
  YOGA_STUDIO
  PERSONAL_TRAINER
  PHOTOGRAPHER
  DRIVING_SCHOOL
  TUTORING
  FLORIST
  JEWELRY
  OTHER
}

enum WebsiteGoal {
  BOOKINGS
  CONTACT
  SHOWCASE
}

enum WebsiteStyle {
  MINIMAL
  BOLD
  ELEGANT
  PLAYFUL
}

enum TextAlign {
  LEFT
  CENTER
}

enum FontPairing {
  MODERN
  CLASSIC
  FRIENDLY
  TECHNICAL
}

enum BusinessStatus {
  DRAFT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Mirrors Stripe's subscription.status values.
enum SubscriptionStatus {
  INCOMPLETE         @map("incomplete")
  INCOMPLETE_EXPIRED @map("incomplete_expired")
  TRIALING           @map("trialing")
  ACTIVE             @map("active")
  PAST_DUE           @map("past_due")
  CANCELED           @map("canceled")
  UNPAID             @map("unpaid")
  PAUSED             @map("paused")
}

model Business {
  id              String         @id @default(cuid())
  // References neon_auth.user.id; no FK because that schema is managed by Neon Auth. Ownership is checked in /lib.
  userId          String         @db.Uuid
  type            BusinessType
  status          BusinessStatus @default(DRAFT)
  slug            String?        @unique
  name            String
  description     String
  goal            WebsiteGoal
  style           WebsiteStyle
  fontPairing     FontPairing
  textAlign       TextAlign
  boldHeadings    Boolean
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  phone           String?
  email           String
  address         String?
  logoUrl         String?
  imageUrls       String[]
  // IANA zone (e.g. "America/New_York"), detected from the owner's device in the questionnaire.
  timezone        String
  // Public website language, chosen by the owner; one of the locales in lib/i18n/config.ts.
  language        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  services     Service[]
  openingHours OpeningHours[]
  staff        Staff[]
  appointments Appointment[]
  messages     Message[]
  subscription Subscription?

  @@index([userId])
}

// A bookable person. A business must always keep at least one active staff member (enforced in /lib).
model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  // Optional linked account (neon_auth.user.id); staff can exist without one.
  userId     String?  @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     StaffService[]
  workingHours StaffWorkingHours[]
  appointments Appointment[]

  @@index([businessId])
  @@index([userId])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

// Same shape as OpeningHours; bookable time is the intersection of both.
model StaffWorkingHours {
  id          String @id @default(cuid())
  staffId     String
  dayOfWeek   Int
  openMinute  Int
  closeMinute Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  priceCents      Int
  durationMinutes Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  appointments Appointment[]

  @@index([businessId])
}

// One row per open interval, so split shifts (e.g. 09:00-14:00 and 16:00-20:00) are two rows.
model OpeningHours {
  id          String @id @default(cuid())
  businessId  String
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  openMinute  Int // minutes since local midnight
  closeMinute Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
}

model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  serviceId     String
  staffId       String
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(PENDING)
  customerName  String
  customerEmail String
  customerPhone String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
}

model Message {
  id         String    @id @default(cuid())
  businessId String
  name       String
  email      String
  phone      String?
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
