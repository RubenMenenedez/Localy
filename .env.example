# Values are pulled from Neon with `neon env pull` (or `neon deploy`), except NEON_AUTH_COOKIE_SECRET.
# The CLI also writes NEON_BRANCH and NEON_AUTH_JWKS_URL; the app does not use them.

# Neon pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string (no "-pooler"). Used by the Prisma CLI for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (managed Better Auth) endpoint for this branch.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"

# Secret used to sign session cookies. At least 32 characters; generate with `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=""
